{
  "name": "dsh-qq-memory",
  "version": "0.1.0",
  "description": "QQ 端专用的小记忆：一叠 markdown，记一条 / 搜一句 / 删一条。零依赖，与主记忆库完全隔离——群友的胡话进不了主库。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "qq",
    "markdown",
    "零依赖",
    "qq-memory"
  ],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
